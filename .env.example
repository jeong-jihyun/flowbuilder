# 이 파일을 .env.local 로 복사해서 값을 채웁니다. (.env.local 은 GitHub에 올라가지 않습니다)

# --- 브라우저에 노출돼도 되는 값 (VITE_ 로 시작) ---
# 2단계(인증)에서 사용
VITE_CLERK_PUBLISHABLE_KEY=

# --- 서버에서만 쓰는 비밀 값 (절대 VITE_ 를 붙이지 않습니다) ---
# 2단계(인증)에서 사용
CLERK_SECRET_KEY=
# 3단계(그룹)부터 사용: MongoDB Atlas 접속 주소
MONGODB_URI=
# 선택: DB 이름 (비우면 flowbuilder)
MONGODB_DB=
# 9단계(외부 연동)에서 사용
# 인증정보(토큰·키) 암호화 키. 32바이트를 base64로. 한 번 정하면 바꾸지 마세요(바꾸면 등록한 인증정보를 못 읽음).
# 만들기(PowerShell): [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
CREDENTIALS_KEY=
# /api/cron 을 부를 때 쓰는 비밀 값. GitHub 저장소 Secret FLOWBUILDER_CRON_SECRET 과 같은 값이어야 합니다.
CRON_SECRET=
