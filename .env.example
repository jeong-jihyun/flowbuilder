# 이 파일을 .env.local 로 복사해서 값을 채웁니다. (.env.local 은 GitHub에 올라가지 않습니다)

# --- 브라우저에 노출돼도 되는 값 (VITE_ 로 시작) ---
# 2단계(인증)에서 사용
VITE_CLERK_PUBLISHABLE_KEY=

# --- 서버에서만 쓰는 비밀 값 (절대 VITE_ 를 붙이지 않습니다) ---
# 2단계(인증)에서 사용
CLERK_SECRET_KEY=
# 6단계(저장)에서 사용
MONGODB_URI=
# 9단계(외부 연동)에서 사용: 외부 실행기 Callback 검증용
RUNNER_CALLBACK_SECRET=
