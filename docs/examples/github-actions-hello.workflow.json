    { "id": "action_2", "type": "action", "position": { "x": 150, "y": 260 }, "data": { "kind": "transform", "label": "결과 문장", "params": { "mapping": "{\n  \"message\": \"GitHub 실행 {{input.conclusion}}: {{input.htmlUrl}}\"\n}" } } }
